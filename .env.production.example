# ==============================================================================
# AstroLogic Production Environment Variables Template
# Copy to .env.production on your server (Never commit actual secrets to Git!)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend Gateway Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace-with-a-secure-random-64-char-string-in-production

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (Leave blank for SQLite, or provide PostgreSQL connection URI)
DATABASE_URL=sqlite:///./astrologic.db
# DATABASE_URL=postgresql://user:password@localhost:5432/astrologic

# Redis (Optional: for distributed task queuing and caching)
# REDIS_URL=redis://localhost:6379/0

# Frontend Connection to Backend
BACKEND_URL=http://backend:8000
BACKEND_API_URL=http://backend:8000

